DOCUVERIFY_CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]
DOCUVERIFY_INBOX_BASE_URL=http://localhost:8080
# Independent LLM verifiers. Keep the values only in .env, never in Git.
# Verifiers A and B reuse the same OpenAI key but must use different models.
DOCUVERIFY_OPENAI_API_KEY=
DOCUVERIFY_OPENAI_VERIFIER_MODEL=gpt-5.4-mini
DOCUVERIFY_OPENAI_VERIFIER_B_MODEL=gpt-4.1-mini
# Optional: absolute path to a different participant bundle.
# DOCUVERIFY_BUNDLE_DIR=C:/datasets/sdoc-hackathon-bundle
# Optional JSON-first sample fallback when the organizer bundle is unavailable.
# DOCUVERIFY_INFERENCE_DIR=C:/datasets/inference_data
# Optional: local fine-tuned model directory and inference device (auto, cpu, or cuda).
# DOCUVERIFY_MODEL_DIR=C:/models/email_multiclass_classifier
DOCUVERIFY_MODEL_DEVICE=auto
# Render Free only: restore the encrypted demo archive at startup and use cached
# BERT results for demo emails, Gemini for new emails. Keep the archive key secret.
# DOCUVERIFY_CLASSIFICATION_MODE=hosted
# DOCUVERIFY_CLASSIFICATION_CACHE_PATH=/tmp/docuverify/classifications.json
# DOCUVERIFY_CLASSIFICATION_HOSTED_MODEL=gemini-2.5-flash
# DOCUVERIFY_DEMO_ARCHIVE_KEY=

# Stage 5 Gemini extraction. PDFs are passed directly for native vision (never commit a real key).
DOCUVERIFY_GEMINI_API_KEY=
DOCUVERIFY_EXTRACTION_PRIMARY_MODEL=gemini-3.8-flash
DOCUVERIFY_EXTRACTION_SECONDARY_MODEL=gemini-3.7-flash
DOCUVERIFY_EXTRACTION_TIMEOUT_SECONDS=60
DOCUVERIFY_EXTRACTION_MAX_RETRIES=1
DOCUVERIFY_EXTRACTION_MAX_INPUT_CHARS=100000

# Google sign-in and Gmail: see GOOGLE_SETUP.md. Never use NEXT_PUBLIC_ for secrets.
DOCUVERIFY_GOOGLE_PROJECT_ID=
DOCUVERIFY_GOOGLE_CLIENT_ID=
DOCUVERIFY_GOOGLE_CLIENT_SECRET=
# Empty uses http://localhost:3000 (the development default).
DOCUVERIFY_APP_ORIGIN=

# Optional hosted fallback. Attachments leave the machine only when deterministic parsing fails.
# DOCUVERIFY_GEMMA_API_KEY=replace-with-a-google-ai-studio-key
DOCUVERIFY_GEMMA_MODEL=gemma-4-26b-a4b-it
DOCUVERIFY_GEMMA_TIMEOUT_MS=120000
# Confidence gates for BERT -> Gemma email classification fallback.
# Tune these on a held-out validation set before production use.
DOCUVERIFY_CLASSIFICATION_MIN_MARGIN=0.20
DOCUVERIFY_CLASSIFICATION_LLM_MIN_CONFIDENCE=0.70
DOCUVERIFY_CLASSIFICATION_THRESHOLD_BL_COMPARISON=0.85
DOCUVERIFY_CLASSIFICATION_THRESHOLD_SI_REQUEST=0.90
DOCUVERIFY_CLASSIFICATION_THRESHOLD_INVOICE_QUERY=0.90
DOCUVERIFY_CLASSIFICATION_THRESHOLD_GENERAL=0.75
DOCUVERIFY_CLASSIFICATION_THRESHOLD_SPAM=0.60
